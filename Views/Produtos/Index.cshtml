@* Passo 03 - CRIAR AS VIEWS *@
@* Se estou na view(Index) de Produtos, qual sera a model que devo sar?*@
@model List<TechStoreMVC.Models.Produto>

@{
   ViewData["Title"] = "Produtos"; 
}

<h1>
    Lista de Produtos
</h1>
<table class="table table-striped">

<thead>
    <tr>
    <th>Id</th>
    <th>Nome</th>
    <th>Preço</th>
    <th>Estoque</th>
    <th>Ações</th>
</tr>
</thead>
<tbody>
    @foreach(Produto produto in Model)
        {
         <tr>

            <td>@produto.Id</td>
             <td>@produto.Nome</td>
              <td>@produto.Preco.ToString("F2")</td>
               <td>@produto.Estoque</td>
               <td>
                <button class="btn btn-primary">Detalhes</button>
               </td>
            </tr>
        }
    </tbody>
